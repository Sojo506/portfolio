# Public site URL, used for metadata, OpenGraph and sitemap generation
NEXT_PUBLIC_SITE_URL=

# WhatsApp number in international format (e.g. 50688888888), no symbols or spaces
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Destination address for the contact form
CONTACT_EMAIL=

# Email provider API keys (only one is required, depending on the provider used)
RESEND_API_KEY=
BREVO_API_KEY=
